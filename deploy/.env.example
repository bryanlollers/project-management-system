APP_DOMAIN=pms.example.com
ACME_EMAIL=you@example.com
# Generate once; preserve this key across deployments.
APP_KEY=
# MySQL server reachable from the API container.
DB_HOST=db.example.com
DB_PORT=3306
DB_DATABASE=pms
DB_USERNAME=pms
DB_PASSWORD=
# Optional CA path inside the API container for remote TLS connections.
MYSQL_ATTR_SSL_CA=
