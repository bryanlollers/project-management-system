APP_DOMAIN=pms.example.com
ACME_EMAIL=you@example.com
# Generate once; preserve this key across deployments.
APP_KEY=
# PostgreSQL server reachable from the API container.
DB_HOST=db.example.com
DB_PORT=5432
DB_DATABASE=pms
DB_USERNAME=pms
DB_PASSWORD=
DB_SCHEMA=pms
# Use require for remote TLS connections; disable only on a trusted local network.
DB_SSLMODE=require
